{
	email __EMAIL__
	on_demand_tls {
		ask http://127.0.0.1:5555/check
	}
}

# Bare host: abuse/info notice (cert auto-managed). Subdomain previews are
# served by the catch-all below via on-demand TLS.
__SUBDOMAIN_HOST__ {
	respond "pugloo preview gateway. URLs here are user-generated developer previews and may be removed at any time. Report abuse: https://github.com/Ani-HQ/pugloo/issues" 200
}

:80 {
	redir https://{host}{uri}
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:8080
}

# on-demand TLS guard: only issue certs for our preview host space
:5555 {
	@ok expression `{query.domain}.endsWith(".__SUBDOMAIN_HOST__")`
	respond @ok 200
	respond 404
}
