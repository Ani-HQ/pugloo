{
	email __EMAIL__
	on_demand_tls {
		ask http://127.0.0.1:5555/check
	}
}

:80 {
	redir https://{host}{uri}
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:8080
}

# on-demand TLS guard: only issue certs for our preview host space
:5555 {
	@ok expression `{query.domain}.endsWith(".__SUBDOMAIN_HOST__")`
	respond @ok 200
	respond 404
}
